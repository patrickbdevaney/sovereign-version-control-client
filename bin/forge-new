#!/usr/bin/env bash
# forge-new — create a repo on the forge and wire a local one to it.
#
# The Forgejo equivalent of `gh repo create`.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

usage() {
    cat <<EOF
usage: forge-new <name|org/name> [options]

Creates the repo on the forge, then points a local repo at it and pushes.

A bare <name> is created in your own namespace. Give an explicit <org/name> to
create it inside an organisation -- that needs a token with write:organization.

If the current directory is a git repo with no 'origin', that repo is adopted.
Otherwise ./<name> is created, initialised, and given a README.

options:
  --public          create a public repo
  --private         create a private repo (default: \$FORGE_DEFAULT_VISIBILITY)
  --desc TEXT       repo description
  --dir PATH        use PATH as the local repo instead of ./<name>
  --no-push         wire up 'origin' but do not push
EOF
}

[ $# -ge 1 ] || { usage >&2; exit 2; }

NAME=""; DESC=""; DIR=""; VISIBILITY=""; DO_PUSH=1
while [ $# -gt 0 ]; do
    case "$1" in
        --public)  VISIBILITY="public" ;;
        --private) VISIBILITY="private" ;;
        --desc)    shift; DESC="${1:-}" ;;
        --dir)     shift; DIR="${1:-}" ;;
        --no-push) DO_PUSH=0 ;;
        -h|--help) usage; exit 0 ;;
        -*)        usage >&2; die "unknown option: $1" ;;
        *)         [ -z "$NAME" ] || die "unexpected argument: $1"; NAME="$1" ;;
    esac
    shift
done

[ -n "$NAME" ] || { usage >&2; die "repo name is required"; }
printf '%s' "$NAME" | grep -qE '^([A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+$' \
    || die "invalid repo name: $NAME (use letters, digits, . _ - and at most one /)"

need git
need curl
load_config
VISIBILITY="${VISIBILITY:-$FORGE_DEFAULT_VISIBILITY}"

# owner/repo, where owner is you unless one was given explicitly.
TARGET="$(qualify "$NAME")"
OWNER="${TARGET%%/*}"
REPO="${TARGET##*/}"

PRIVATE_JSON="true"
[ "$VISIBILITY" = "public" ] && PRIVATE_JSON="false"

# --- decide where the local repo lives --------------------------------------

ADOPTED=0
if [ -z "$DIR" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git remote get-url origin >/dev/null 2>&1; then
        die "this directory already has an 'origin' remote:
  $(git remote get-url origin)
Use --dir to create the repo somewhere else."
    fi
    DIR="$(git rev-parse --show-toplevel)"
    ADOPTED=1
fi
# The local directory is named after the repo, never owner/repo.
DIR="${DIR:-$PWD/$REPO}"

# The target directory may already be a repo wired to a remote -- either from
# --dir, or because ./<name> happens to exist. Catch it HERE, before anything is
# created server-side: `git remote add origin` would fail afterwards and leave an
# orphaned empty repository on the forge.
if [ "$ADOPTED" -eq 0 ] && [ -e "$DIR/.git" ]; then
    if existing_origin="$(git -C "$DIR" remote get-url origin 2>/dev/null)"; then
        die "$DIR is already a git repo, and its 'origin' is:
  $existing_origin
Nothing was created on the forge. To publish that repo somewhere else, add a
second remote instead:
  git -C \"$DIR\" remote add <name> $(ssh_url "$TARGET")"
    fi
fi

# --- create it on the server ------------------------------------------------

step "create $TARGET on $FORGE_HOST ($VISIBILITY)"

# Your own namespace and an organisation are different endpoints.
if [ "$OWNER" = "$FORGE_USER" ]; then
    ENDPOINT="/user/repos"
else
    ENDPOINT="/orgs/$OWNER/repos"
fi

body="$(mktemp)"; chmod 600 "$body"
python3 -c '
import json, sys
json.dump({"name": sys.argv[1],
           "description": sys.argv[2],
           "private": sys.argv[3] == "true",
           "auto_init": False,
           "default_branch": "main"},
          open(sys.argv[4], "w"))
' "$REPO" "$DESC" "$PRIVATE_JSON" "$body"

resp="$(api POST "$ENDPOINT" "$body")"
rm -f "$body"
code="$(resp_code "$resp")"

case "$code" in
    201) ok "created $(resp_body "$resp" | json_field full_name)" ;;
    409) warn "repo already exists on the server; wiring the local side to it" ;;
    404) die "no such organisation '$OWNER' on $FORGE_HOST, or you cannot see it.
Existing owners are listed at https://$FORGE_HOST/explore/organizations" ;;
    401|403)
        msg="$(resp_body "$resp" | json_field message)"
        if [ "$OWNER" != "$FORGE_USER" ]; then
            die "cannot create in organisation '$OWNER' (HTTP $code).
${msg:+Server said: $msg
}Creating a repo inside an organisation needs a token with the
write:organization scope, which a user-namespace token does not have.
Regenerate at https://$FORGE_HOST/user/settings/applications with
write:user, write:repository and write:organization."
        fi
        die "authentication failed (HTTP $code). Check your token or password.${msg:+
Server said: $msg}" ;;
    000) die "could not reach $FORGE_API — run forge-doctor" ;;
    *)   die "create failed (HTTP $code): $(resp_body "$resp")" ;;
esac

# auto_init is off on purpose: an empty remote means the first push can never
# hit an unrelated-histories conflict.

# --- wire up the local repo -------------------------------------------------

info ""
if [ "$ADOPTED" -eq 1 ]; then
    step "using existing repo at $DIR"
else
    step "local repo at $DIR"
fi

mkdir -p "$DIR"
cd "$DIR"

if [ ! -d .git ]; then
    git init -q -b main
    ok "git init"
fi

# A brand-new repo needs something to commit; an adopted one is left alone.
if ! git rev-parse HEAD >/dev/null 2>&1; then
    if [ -z "$(git status --porcelain)" ]; then
        {
            printf '# %s\n\n' "$REPO"
            [ -n "$DESC" ] && printf '%s\n\n' "$DESC"
            printf 'Hosted on a private Forgejo instance.\n\n'
            printf '    git clone %s\n' "$(ssh_url "$TARGET")"
        } > README.md
        git add README.md
        ok "seeded README.md"
    else
        git add -A
        ok "staged existing files"
    fi
    git commit -q -m "Initial commit"
    ok "initial commit"
fi

git remote add origin "$(ssh_url "$TARGET")"
ok "origin -> $(ssh_url "$TARGET")"

# --- push -------------------------------------------------------------------

info ""
if [ "$DO_PUSH" -eq 0 ]; then
    warn "skipping push (--no-push).  git push -u origin main"
else
    step "push"
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if git push -u origin "$branch"; then
        ok "pushed $branch"
    else
        die "push failed. Run forge-doctor to find out why."
    fi
fi

info ""
info "  web:  $(web_url "$TARGET")"
info "  ssh:  $(ssh_url "$TARGET")"
